---
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedAt?: string | Date;
  tags?: string[];
  noindex?: boolean;
  schema?: Record<string, any> | Record<string, any>[];
}

import Header from "../components/layouts/Header.astro";
const {
  title,
  description,
  image,
  type = "website",
  publishedAt,
  tags,
  noindex = false,
  schema,
} = Astro.props as Props;

const SITE = "https://nirab.me";
const AUTHOR = "Istiaq Nirab";

const defaultDescription =
  "Istiaq Nirab — full stack + AI engineer. WordPress/WooCommerce plugins on wordpress.org, and product engineering with Django, Laravel, Next.js and AI.";
const defaultImg = "/me.jpeg";

const desc = description ?? defaultDescription;
const site = Astro.site ?? new URL(SITE);

// Normalise to a trailing-slash canonical so /foo and /foo/ collapse to one URL.
const path = Astro.url.pathname.replace(/\/+$/, "");
const canonical = new URL(path === "" ? "/" : `${path}/`, site).href;
const ogImage = new URL(image ?? defaultImg, site).href;

const published = publishedAt ? new Date(publishedAt).toISOString() : undefined;

const personSchema = {
  "@type": "Person",
  "@id": `${SITE}/#person`,
  name: AUTHOR,
  url: SITE,
  image: `${SITE}${defaultImg}`,
  jobTitle: "Full stack + AI engineer",
  address: { "@type": "PostalAddress", addressLocality: "Dhaka", addressCountry: "BD" },
  sameAs: [
    "https://github.com/ok9xnirab",
    "https://bd.linkedin.com/in/ok9xnirab",
    "https://dev.to/ok9xnirab",
    "https://twitter.com/Ok9xNirab",
    "https://profiles.wordpress.org/ok9xnirab/",
  ],
};

const pageSchema =
  type === "article"
    ? {
        "@type": "BlogPosting",
        headline: title,
        description: desc,
        image: ogImage,
        datePublished: published,
        dateModified: published,
        keywords: tags?.join(", "),
        inLanguage: "en",
        author: { "@id": `${SITE}/#person` },
        publisher: { "@id": `${SITE}/#person` },
        mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      }
    : {
        "@type": "WebPage",
        name: title,
        description: desc,
        url: canonical,
        inLanguage: "en",
        isPartOf: { "@id": `${SITE}/#website` },
        about: { "@id": `${SITE}/#person` },
      };

const websiteSchema = {
  "@type": "WebSite",
  "@id": `${SITE}/#website`,
  url: SITE,
  name: `${AUTHOR} — full stack + AI engineer`,
  publisher: { "@id": `${SITE}/#person` },
  inLanguage: "en",
};

const graph = [
  personSchema,
  websiteSchema,
  pageSchema,
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
];

const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph });
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={AUTHOR} />
    <link rel="canonical" href={canonical} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={AUTHOR} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {published && <meta property="article:published_time" content={published} />}
    {type === "article" && <meta property="article:author" content={AUTHOR} />}
    {type === "article" && (tags ?? []).map((t) => <meta property="article:tag" content={t} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Ok9xNirab" />
    <meta name="twitter:creator" content="@Ok9xNirab" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <meta name="theme-color" content="#0b0b0c" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${AUTHOR} — Writing`}
      href="/rss.xml"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a href="#main" class="skiplink">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap fin">
        <span>© 2026 Istiaq Nirab</span>
        <span class="sociallist">
          <a href="https://github.com/ok9xnirab" target="_blank" rel="noreferrer">github</a>
          <a href="https://bd.linkedin.com/in/ok9xnirab" target="_blank" rel="noreferrer">linkedin</a>
          <a href="https://dev.to/ok9xnirab" target="_blank" rel="noreferrer">dev.to</a>
          <a href="https://twitter.com/Ok9xNirab" target="_blank" rel="noreferrer">x / twitter</a>
        </span>
        <span>Dhaka, BD · GMT+6</span>
      </div>
    </footer>

    <script>
      document.addEventListener("keydown", (e) => {
        const tag = (e.target as HTMLElement).tagName;
        if (tag === "INPUT" || tag === "TEXTAREA") return;
        const map: Record<string, string> = {
          "1": "/",
          "2": "/work/",
          "3": "/blog/",
          "4": "/curated/",
          "5": "/plugins/",
          "6": "/about/",
          "7": "/contact/",
        };
        if (map[e.key]) window.location.href = map[e.key];
      });
    </script>
  </body>
</html>
