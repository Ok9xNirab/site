---
// GitHub Discussions-backed comments. Threads are matched to posts by the
// page's og:title, so keep post titles stable once published.
// The script tag is built at runtime so giscus starts in the theme pinned
// by the footer switcher; later switches are sent to the iframe directly.
---

<div class="comments" id="giscus-mount"></div>
<script is:inline>
  (function () {
    var attrs = {
      src: "https://giscus.app/client.js",
      "data-repo": "Ok9xNirab/site",
      "data-repo-id": "R_kgDOIFulhw",
      "data-category": "General",
      "data-category-id": "DIC_kwDOIFulh84DFP62",
      "data-mapping": "og:title",
      "data-strict": "0",
      "data-reactions-enabled": "1",
      "data-emit-metadata": "0",
      "data-input-position": "bottom",
      "data-theme": document.documentElement.dataset.theme || "preferred_color_scheme",
      "data-lang": "en",
      "data-loading": "lazy",
      crossorigin: "anonymous",
    };
    var s = document.createElement("script");
    for (var k in attrs) s.setAttribute(k, attrs[k]);
    s.async = true;
    document.getElementById("giscus-mount").appendChild(s);
  })();
</script>
