---
import Default from "@layouts/default.astro";
// KaTeX stylesheet, scoped to post pages since they are the only ones with math.
import "katex/dist/katex.min.css";
import Eyebrow from "@components/Eyebrow.astro";
import Contact from "@components/Contact.astro";
import Giscus from "@components/Giscus.astro";
import { getFormattedDate, getShortDate } from "@utils/index";

export async function getStaticPaths() {
  const posts = (await Astro.glob("./../../../posts/**/*.{md,mdx}")).filter(
    (post) => !post.frontmatter.draft
  );

  const paths = [] as any[];

  posts.forEach((post) => {
    paths.push({
      params: { path: post.frontmatter.path },
      props: { post: post },
    });
  });
  return paths;
}

const { post } = Astro.props;
const { Content } = post;

const allPosts = (await Astro.glob("./../../../posts/**/*.{md,mdx}"))
  .filter((p) => !p.frontmatter.draft)
  .sort((a, b) => Date.parse(b.frontmatter.date) - Date.parse(a.frontmatter.date));
const more = allPosts.filter((p) => p.frontmatter.path !== post.frontmatter.path).slice(0, 3);

const breadcrumbs = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nirab.me/" },
    { "@type": "ListItem", position: 2, name: "Writing", item: "https://nirab.me/blog" },
    {
      "@type": "ListItem",
      position: 3,
      name: post.frontmatter.title,
      item: `https://nirab.me/post/${post.frontmatter.path}`,
    },
  ],
};
---

<Default
  title={`${post.frontmatter.title} | Istiaq Nirab`}
  description={post.frontmatter.excerpt}
  type="article"
  publishedAt={post.frontmatter.date}
  tags={post.frontmatter.tags ?? []}
  schema={breadcrumbs}
>
  <div class="page">
    <section class="post-hero">
      <div class="wrap-n">
        <a class="backlink" href="/blog">← Writing</a>
        <div style="display: flex; gap: 14px; align-items: baseline; margin: 34px 0 20px; flex-wrap: wrap;">
          {(post.frontmatter.tags ?? []).map((tag: string) => (
            <a href={`/tag/${tag}`} class="chip chip-a">{tag}</a>
          ))}
          <span class="mono">{getFormattedDate(post.frontmatter.date)}</span>
        </div>
        <h1 class="h2" style="font-size: clamp(34px,5.4vw,58px);">{post.frontmatter.title}</h1>
        {post.frontmatter.excerpt && <p class="lead" style="margin-top: 22px; max-width: 36em;">{post.frontmatter.excerpt}</p>}
      </div>
    </section>

    <section class="sec sec-t" style="padding-top: 56px;">
      <div class="wrap-n post-body">
        <div class="prose-editorial">
          <Content />
        </div>
        <div class="post-foot">
          <div class="post-author">
            <span class="av"><img src="/me-classic.jpeg" alt="Istiaq Nirab" width="48" height="48" loading="lazy" decoding="async" /></span>
            <div>
              <div class="an">Istiaq Nirab</div>
              <div class="ar">Full stack + AI engineer</div>
            </div>
          </div>
          <div class="share-row">
            <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.frontmatter.title)}`} target="_blank" rel="noreferrer">X / Twitter</a>
            <a href={`https://www.facebook.com/sharer/sharer.php?u=https://nirab.me/post/${post.frontmatter.path}`} target="_blank" rel="noreferrer">Facebook</a>
            <a href={`https://news.ycombinator.com/submitlink?t=${encodeURIComponent(post.frontmatter.title)}`} target="_blank" rel="noreferrer">Hacker News</a>
          </div>
        </div>
      </div>
    </section>

    <section class="sec sec-t">
      <div class="wrap-n">
        <Eyebrow>Discussion</Eyebrow>
        <p class="body" style="margin-bottom: 20px;">Comments run on giscus, backed by GitHub Discussions — sign in with GitHub to reply.</p>
        <Giscus />
      </div>
    </section>

    {more.length > 0 && (
      <section style="padding: 0 0 88px;">
        <div class="wrap-post">
          <Eyebrow>More posts</Eyebrow>
          <div class="post-carousel">
            {more.map((x) => (
              <a class="post-card" href={`/post/${x.frontmatter.path}`}>
                <span class="chip chip-a">{(x.frontmatter.tags ?? [])[0] ?? "post"}</span>
                <h3 class="h3" style="font-size: 19px;">{x.frontmatter.title}</h3>
                <p class="body" style="font-size: 13.5px;">{x.frontmatter.excerpt}</p>
                <span class="mono mute" style="margin-top: auto;">{getShortDate(x.frontmatter.date)}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
    <Contact />
  </div>
</Default>
