---
import Default from "@layouts/default.astro";
import Eyebrow from "@components/Eyebrow.astro";
import CaseRow from "@components/CaseRow.astro";
import Contact from "@components/Contact.astro";
import { PROFILE, DISCIPLINES, STACK } from "@data/site.js";
import { CASES } from "@data/cases.js";

const featured = CASES;
---

<Default title="Istiaq Nirab — full stack + AI engineer">
  <div class="page">
    <section class="hero">
      <div class="wrap">
        <p class="mono" style="margin-bottom: 30px;">{PROFILE.place} · {PROFILE.tz} · open to new work</p>
        <h1 class="display">Full stack &amp; AI engineer.<br />I build products <span class="it">end to end</span>.</h1>
        <div class="hero-meta">
          <div><span class="mono">Currently</span><span class="v">Freelance &amp; contract</span></div>
          <div><span class="mono">Experience</span><span class="v" style="white-space: nowrap;">{PROFILE.years} years</span></div>
          <div><span class="mono">Disciplines</span><span class="v">WordPress · Full stack · AI</span></div>
          <div><span class="mono">Written in</span><span class="v">PHP · Python · TypeScript</span></div>
        </div>
      </div>
    </section>

    <section class="sec sec-t">
      <div class="wrap">
        <Eyebrow right="03 practices">What I do</Eyebrow>
        <div class="disc">
          {DISCIPLINES.map((d) => (
            <div>
              <h3 class="h3">{d.title}</h3>
              <p class="lead" style="margin: 16px 0 14px; font-size: 18px;">{d.line}</p>
              <p class="body" style="font-size: 15.5px;" set:html={d.body} />
              <ul>{d.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="sec sec-t">
      <div class="wrap">
        <Eyebrow right={`${CASES.length} case studies`}>Selected work</Eyebrow>
        <div class="rows">{featured.map((c) => <CaseRow c={c} />)}</div>
        <a class="backlink" style="margin-top: 28px; display: inline-flex;" href="/work/">All work <span class="arrow">→</span></a>
      </div>
    </section>

    <section class="sec sec-t">
      <div class="wrap">
        <Eyebrow>Toolkit</Eyebrow>
        <div class="stackg">
          {STACK.map((g) => (
            <div>
              <h4>{g.group}</h4>
              <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Contact />
  </div>
</Default>
