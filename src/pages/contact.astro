---
import Default from "@layouts/default.astro";
import Contact from "@components/Contact.astro";
import { PROFILE } from "@data/site.js";
---

<Default title="Contact | Istiaq Nirab" description="Open for freelance plugin work, WooCommerce builds, and AI engineering projects.">
  <div class="page">
    <section class="hero" style="padding-bottom: 20px;">
      <div class="wrap">
        <p class="mono" style="margin-bottom: 26px;">{PROFILE.place} · {PROFILE.tz}</p>
        <h1 class="display" style="font-size: clamp(40px,7vw,86px);">Say hi<span class="it">.</span></h1>
        <p class="lead" style="margin-top: 26px;">Open for freelance plugin work, WooCommerce builds, and AI engineering projects. I usually reply within a day.</p>
      </div>
    </section>
    <Contact />
  </div>
</Default>
